{
	"name": "parse-roblox-errors",
	"description": "A TypeScript library for parsing Roblox web API errors",
	"version": "1.2.4",
	"type": "module",
	"license": "MIT",
	"homepage": "https://github.com/RoSeal-Extension/Parse-Roblox-Errors",
	"repository": {
		"type": "git",
		"url": "https://github.com/RoSeal-Extension/Parse-Roblox-Errors.git"
	},
	"bugs": {
		"url": "https://github.com/RoSeal-Extension/Parse-Roblox-Errors/issues"
	},
	"keywords": [
		"roblox",
		"errors",
		"api"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.js",
				"default": "./dist/index.js"
			}
		},
		"./challenge": {
			"import": {
				"types": "./dist/utils/parseChallengeHeaders.d.ts",
				"default": "./dist/utils/parseChallengeHeaders.js"
			}
		},
		"./package.json": "./package.json"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "latest",
		"@biomejs/biome": "latest",
		"@types/whatwg-mimetype": "^5.0.0"
	},
	"scripts": {
		"build": "bunx bunup src/index.ts src/utils/parseChallengeHeaders.ts --silent"
	},
	"dependencies": {
		"whatwg-mimetype": "^5.0.0"
	}
}